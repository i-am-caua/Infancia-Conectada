  description="A página sobre o projeto Cuidado Digital está em construção."
>
  <section class="construction-page shell" aria-labelledby="pagina-em-construcao">
    <div>
      <p class="eyebrow">Sobre o projeto</p>
      <h1 id="pagina-em-construcao">Esta página ainda está sendo construída.</h1>
      <p>
        Em breve, você encontrará aqui mais informações sobre o Cuidado Digital.
      </p>
      <a class="button" href="/">Voltar para a página inicial</a>
    </div>
  </section>
</BaseLayout>
