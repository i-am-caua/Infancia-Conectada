---
import '@fontsource/open-sans/latin-400.css';
import '@fontsource/open-sans/latin-600.css';
import '@fontsource/open-sans/latin-700.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  pageType?: 'website' | 'article';
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title = 'Infância Conectada',
  description = 'Informação confiável para orientar crianças no mundo digital.',
  pageType = 'website',
  socialImage = '/brand/logoif.webp',
  socialImageAlt = 'Marca do Instituto Federal Goiano',
} = Astro.props;

const pageTitle = title === 'Infância Conectada' ? title : `${title} | Infância Conectada`;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageUrl = Astro.site ? new URL(socialImage, Astro.site) : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#176b2d" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Infância Conectada" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
