---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" description="A página solicitada não foi encontrada.">
  <section class="page-header shell">
    <p class="eyebrow">Erro 404</p>
    <h1>Este conteúdo não está por aqui.</h1>
    <p>O endereço pode ter mudado ou ter sido digitado de outra forma.</p>
    <a class="button" href="/">Voltar para a página inicial</a>
  </section>
</BaseLayout>
