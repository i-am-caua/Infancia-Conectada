---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import { formatDate, slugify } from '../lib/content';

interface Props {
  article: CollectionEntry<'artigos'>;
}

const { article } = Astro.props;
const { data } = article;
---

<BaseLayout
  title={data.title}
  description={data.description}
  pageType="article"
  socialImage={data.cover?.src}
  socialImageAlt={data.cover?.alt}
>
  <article class="article-page">
    <header class="article-header shell-narrow">
      <a class="eyebrow topic-link" href={`/temas/#${slugify(data.topic)}`}>
        {data.topic}
      </a>
      <h1>{data.title}</h1>
      <p class="article-deck">{data.description}</p>
      <dl class="article-meta" aria-label="Informações da publicação">
        <div>
          <dt>Por</dt>
          <dd>{data.author}</dd>
        </div>
        <div>
          <dt>Publicado</dt>
          <dd><time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time></dd>
        </div>
        <div>
          <dt>Revisado</dt>
          <dd><time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time></dd>
        </div>
        <div>
          <dt>Leitura</dt>
          <dd>{data.readingMinutes} min</dd>
        </div>
      </dl>
    </header>

    {data.cover && (
      <figure class="article-cover shell-narrow">
        <img
          src={data.cover.src}
          alt={data.cover.alt}
          width={data.cover.width}
          height={data.cover.height}
          loading="eager"
          decoding="async"
        />
        {data.cover.caption && <figcaption>{data.cover.caption}</figcaption>}
      </figure>
    )}

    <div class="article-body prose shell-narrow">
      <slot />
    </div>

    {data.video?.provider === 'youtube' && (
      <div class="shell-narrow">
        <YouTubeEmbed id={data.video.id} title={data.video.title} />
      </div>
    )}

    <footer class="article-footer shell-narrow">
      <section aria-labelledby="fontes-titulo">
        <h2 id="fontes-titulo">Fontes e materiais consultados</h2>
        <ul class="source-list">
          {data.sources.map((source) => (
            <li>
              <a href={source.url} rel="noreferrer">{source.title}</a>
              <span>Acesso em {source.accessedAt}.</span>
            </li>
          ))}
        </ul>
      </section>
      <a class="text-link back-link" href="/artigos/">← Ver todos os artigos</a>
    </footer>
  </article>
</BaseLayout>
