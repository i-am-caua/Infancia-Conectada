---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortArticles } from '../../lib/content';

const articles = sortArticles((await getCollection('artigos')).filter((article) => !article.data.draft));
---

<BaseLayout
  title="Artigos"
  description="Conteúdos práticos para famílias sobre segurança, diálogo e bem-estar no uso de tecnologias."
>
  <header class="page-header shell">
    <p class="eyebrow">Biblioteca Cuidado Digital</p>
    <h1>Orientações para ler, conversar e colocar em prática.</h1>
    <p>
      Cada artigo parte de uma situação cotidiana, explica por que ela importa e termina com uma ação possível para a família.
    </p>
  </header>

  <section class="section shell" aria-labelledby="todos-artigos">
    <div class="section-heading">
      <h2 id="todos-artigos">Todos os artigos</h2>
      {articles.length > 0 && <p>{articles.length} {articles.length === 1 ? 'conteúdo publicado' : 'conteúdos publicados'}</p>}
    </div>
    {articles.length > 0 ? <ArticleList articles={articles} /> : (
      <div class="prose shell-narrow" style="margin-inline: 0">
        <p>Estamos preparando nosso primeiro artigo. Em breve, você encontrará aqui orientações para o dia a dia da sua família.</p>
        <p><a href="/sobre/">Conheça o Cuidado Digital</a></p>
      </div>
    )}
  </section>
</BaseLayout>
